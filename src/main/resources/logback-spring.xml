<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>method</includeMdcKeyName>
            <includeMdcKeyName>uri</includeMdcKeyName>
            <includeContext>false</includeContext>
        </encoder>
    </appender>

    <!-- Use CONSOLE by default (pattern from application.yml includes requestId).
         To enable JSON logs, set ANVESH_JSON_LOGS=true and add -Dlogging.config or use
         logstash profile. For now we keep it simple to avoid Janino dependency. -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="dev.bhavya.anvesh" level="INFO"/>
    <logger name="org.springframework.jdbc" level="WARN"/>
</configuration>
